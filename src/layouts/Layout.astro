---
import { getImage } from "astro:assets";
import heroImage from "../assets/photo_la_gaille_1.jpg";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const {
  title,
  description = "La Gaille, humoriste stand-up à Lyon. One-man-show « Entre Rire et Réalité ».",
  ogType = "website",
} = Astro.props;

const SITE = (Astro.site?.href ?? "https://lagaille.fr/").replace(/\/$/, "");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Image Open Graph optimisée (1200×630) générée au build — évite de servir
// la photo source de plusieurs Mo aux scrapers sociaux et aux aperçus IA.
const og = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "top",
  format: "jpeg",
});
const ogImageURL = new URL(og.src, Astro.site);

// Graphe d'entités sitewide : présent sur TOUTES les pages pour consolider
// l'entité « La Gaille » aux yeux de Google et des moteurs génératifs (GEO).
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: `${SITE}/`,
      name: "La Gaille — Humoriste stand-up à Lyon",
      inLanguage: "fr-FR",
      publisher: { "@id": `${SITE}/#organization` },
      about: { "@id": `${SITE}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      name: "La Gaille",
      url: `${SITE}/`,
      image: ogImageURL.href,
      description:
        "Humoriste stand-up basé à Lyon, auteur et interprète du one-man-show « Entre Rire et Réalité ». Ancien ingénieur informaticien reconverti dans le stand-up.",
      jobTitle: "Humoriste",
      knowsAbout: [
        "Stand-up",
        "One-man-show",
        "Humour",
        "Spectacle vivant",
        "Café-théâtre",
      ],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Lyon",
        addressRegion: "Auvergne-Rhône-Alpes",
        addressCountry: "FR",
      },
      workLocation: { "@type": "Place", name: "Lyon, France" },
      award: "Prix du public Kandidator 2024",
      worksFor: { "@id": `${SITE}/#organization` },
      sameAs: ["https://www.instagram.com/la_gaille_/"],
    },
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Pattedoie Productions",
      url: `${SITE}/`,
      email: "julien.gallego.pro@gmail.com",
      description: "Production et diffusion de spectacles d'humour.",
    },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph -->
    <meta property="og:site_name" content="La Gaille" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="La Gaille, humoriste stand-up à Lyon" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- Données structurées JSON-LD (graphe d'entités sitewide) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Données structurées spécifiques à la page (Event, BlogPosting, FAQPage, BreadcrumbList) -->
    <slot name="head" />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YB40WS0EY9"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-YB40WS0EY9");
    </script>
    <!-- Wispra Pixel V2 -->
    <script>
      (function (d, t) {
        var id = "__wispra_v2_" + t;
        if (d.getElementById(id)) return;
        var s = d.createElement("script");
        s.id = id;
        s.src = "https://api.wispra.fr/tag/" + t + "/v2/script.js";
        s.async = true;
        s.onerror = function () {
          setTimeout(function () {
            var r = d.createElement("script");
            r.src = s.src;
            r.async = true;
            (d.head || d.body).appendChild(r);
          }, 2000);
        };
        (
          d.head ||
          d.getElementsByTagName("head")[0] ||
          d.body ||
          d.documentElement
        ).appendChild(s);
      })(document, "492746cd-fcb1-45fa-9ee8-ec26c6a5eb7e");
    </script>
    <!-- Fin Wispra Pixel V2 -->

    <!-- Redploy -->
  </head>
  <body>
    <slot />
    <footer>
      <div class="container">
        <p>
          © {new Date().getFullYear()} La Gaille &mdash; Production <a
            href="mailto:julien.gallego.pro@gmail.com">Pattedoie Productions</a>
        </p>
        <nav class="footer-links">
          <a href="/blog">Blog</a>
          <a href="/faq">FAQ</a>
          <a
            href="https://www.instagram.com/la_gaille_/"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
            </svg>
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-surface: #f7f6f4;
    --color-text: #111111;
    --color-muted: #666666;
    --color-accent: #c9a84c;
    --color-border: #e8e8e8;
    --color-cta-bg: #111111;
    --color-cta-text: #ffffff;
    --max-width: 1100px;
    --section-padding: 5rem 1.5rem;
    --font-display: "Cormorant Garamond", Georgia, serif;
    --font-body: "Inter", system-ui, sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
    background: var(--color-bg);
  }

  section[id] {
    scroll-margin-top: 70px;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.1;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  footer {
    background: var(--color-text);
    color: #aaa;
    padding: 2rem 1.5rem;
    font-size: 0.85rem;
  }

  footer .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  footer a {
    color: #aaa;
    transition: color 0.2s;
  }

  footer a:hover {
    color: var(--color-accent);
  }

  footer .footer-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 600px) {
    :root {
      --section-padding: 3rem 1.25rem;
    }
  }
</style>
