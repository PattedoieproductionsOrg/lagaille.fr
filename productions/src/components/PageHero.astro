---
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<div class="page-hero">
  <div class="container">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</div>

<style>
  .page-hero {
    background: var(--color-surface);
    padding: calc(68px + 4rem) 1.5rem 4rem;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  h1::after {
    content: "";
    display: block;
    width: 64px;
    height: 4px;
    margin-top: 1rem;
    background: var(--color-accent);
  }

  .lead {
    margin-top: 1.5rem;
    max-width: 620px;
    color: var(--color-muted);
    font-size: 1.1rem;
  }
</style>
